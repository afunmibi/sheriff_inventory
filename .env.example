# Tech Application - Environment Configuration Template
# Copy this file to .env and fill in your values

# Application
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your-random-32-character-key-here
APP_NAME="Tech Application"
APP_URL=http://localhost:8080
ALLOWED_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sheriff_inventory
DB_USERNAME=root
DB_PASSWORD=

# Paystack (Nigeria Payment Gateway)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_MODE=test

# Session
SESSION_TIMEOUT=900

# Timezone
TIMEZONE=Africa/Lagos

# Logging
LOG_LEVEL=error
LOG_PATH=storage/logs/

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=public/uploads/
